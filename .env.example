LLM_PROVIDER=sarvam
SARVAM_MODEL=sdf
SARVAM_API_KEY=df
GEMINI_MODEL=gemini-2.5-flash
AIVAR_HEADLESS=true
COVERAGE_THRESHOLD=0.75
MAX_REPLAN_ATTEMPTS=2
MAX_HEAL_ATTEMPTS=1
SARVAM_MAX_TOKENS=4096
SARVAM_REASONING_EFFORT=none
# Set this to a remote browser-as-a-service CDP websocket URL (e.g. from
# Browserless.io or Browserbase) to run Playwright against a managed
# remote Chromium instead of launching one locally. Useful on hosts that
# can't install/persist Playwright's browser binaries at runtime, such as
# Vercel's Python serverless functions. Leave empty to launch Chromium
# locally (e.g. inside a Docker container that already has it installed).
# Example (Browserless): wss://production-sfo.browserless.io?token=YOUR_API_TOKEN
BROWSER_WS_ENDPOINT=